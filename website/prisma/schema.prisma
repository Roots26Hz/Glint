generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PageView {
  id        String   @id @default(cuid())
  sessionId String
  path      String
  country   String?
  browser   String?
  os        String?
  device    String?
  createdAt DateTime @default(now())
}

model Event {
  id        String   @id @default(cuid())
  sessionId String
  type      String   // e.g. "DOWNLOAD", "GITHUB_CLICK"
  metadata  String?  // JSON string
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id
  duration  Int      @default(0) // Seconds
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
